        # Load report text from DOCX
        try:
            from docx import Document
            doc = Document("/Users/adityanarayanrautaray/Downloads/Final_report_for_Hyper-key_Generator.docx")
            report_text = "\n".join([para.text for para in doc.paragraphs])
        except Exception as e:
