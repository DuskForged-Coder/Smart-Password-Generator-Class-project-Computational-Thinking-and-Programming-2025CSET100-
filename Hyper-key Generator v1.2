    # ---------------- Chess helpers ----------------
    def _init_chess_mappings(self):
        # Board view: row 0 is top (rank 8), col 0 is left (file a)
        self.square_to_coord = {}
        self.coord_to_square = {}
        files = "abcdefgh"
        ranks = "87654321"
        for r in range(8):
            for c in range(8):
                coord = f"{files[c]}{ranks[r]}"
                self.square_to_coord[(r, c)] = coord
                self.coord_to_square[coord] = (r, c)

    def _new_chess_game(self):
        self.chess_board = chess.Board()
        self.selected_square = None
        self.play_as_white = True  # default: user plays White
        self.moves_box.delete("0.0", tk.END)
        self._draw_board()

    def _switch_sides(self):
        self.play_as_white = not self.play_as_white
        # if playing as black, let AI (white) move first
        if not self.play_as_white:
            self.after(200, self._maybe_ai_move)
        self._draw_board()

    def _undo_move(self):
        if self.chess_board.move_stack:
            self.chess_board.pop()
            # If AI also moved, pop one more to return to user's turn
            if self.chess_board.turn != (self.play_as_white):
                if self.chess_board.move_stack:
                    self.chess_board.pop()
            self._update_moves_box()
            self._draw_board()

    def _on_square_click(self, row, col):
        coord = self.square_to_coord[(row, col)]
        sq_index = chess.parse_square(coord)
        piece = self.chess_board.piece_at(sq_index)

        # If no selection yet:
        if not self.selected_square:
            # select only if piece of player's color or empty (to allow deselect)
            if piece is None:
                return
            if (piece.color == chess.WHITE and self.play_as_white) or (piece.color == chess.BLACK and not self.play_as_white):
                self.selected_square = (row, col)
                self._draw_board(highlight=(row, col))
            else:
                return
        else:
            # attempt move from selected_square -> clicked square
            from_coord = self.square_to_coord[self.selected_square]
            to_coord = coord
            move_uci = from_coord + to_coord
            move = None
            try:
                move = chess.Move.from_uci(move_uci)
            except Exception:
                # maybe promotion required (handle basics: promote to queen if pawn reaches last rank)
                pass

            legal = False
            if move and move in self.chess_board.legal_moves:
                legal = True
            else:
                # try promotions
                for promo in ['q','r','b','n']:
                    try:
                        m = chess.Move.from_uci(move_uci + promo)
                        if m in self.chess_board.legal_moves:
                            move = m
                            legal = True
                            break
                    except Exception:
                        continue

            if legal and move:
                self.chess_board.push(move)
                self._update_moves_box()
                self.selected_square = None
                self._draw_board()
                # after user move, AI move if it's AI's turn
                self.after(200, self._maybe_ai_move)
            else:
                # if clicked own piece, change selection
                if piece is not None and ((piece.color == chess.WHITE and self.play_as_white) or (piece.color == chess.BLACK and not self.play_as_white)):
                    self.selected_square = (row, col)
                    self._draw_board(highlight=(row, col))
                else:
                    # invalid move - deselect
                    self.selected_square = None
                    self._draw_board()

    def _maybe_ai_move(self):
        # If game over or it's user's turn, do nothing
        if self.chess_board.is_game_over():
            return
        is_ai_turn = (self.chess_board.turn != self.play_as_white)
        if is_ai_turn:
            # AI to move
            self._ai_move()

    def _ai_move(self):
        depth = int(self.ai_depth_var.get()) if hasattr(self, "ai_depth_var") else self.ai_depth
        # if few legal moves, pick random to save time
        legal_count = self.chess_board.legal_moves.count()
        if legal_count <= 6:
            move = random.choice(list(self.chess_board.legal_moves))
        else:
            # Use minimax from AI perspective. maximizing = White
            maximizing = True if self.chess_board.turn == chess.WHITE else False
            score, move = minimax(self.chess_board, depth, -float("inf"), float("inf"), maximizing)
            if move is None:
                move = random.choice(list(self.chess_board.legal_moves))
        # execute AI move
        self.chess_board.push(move)
        self._update_moves_box()
        self._draw_board()

    def _update_moves_box(self):
        # show SAN moves
        moves = list(self.chess_board.move_stack)
        board = chess.Board()
        san_lines = []
        for i, m in enumerate(moves):
            if i % 2 == 0:
                san_lines.append(f"{(i//2)+1}. ")
            san_lines[-1] += board.san(m) + (" " if i % 2 == 0 else "\n")
            board.push(m)
        self.moves_box.delete("0.0", tk.END)
        self.moves_box.insert(tk.END, "".join(san_lines))
        # detect end of game
        if self.chess_board.is_checkmate():
            winner = "Black" if self.chess_board.turn == chess.WHITE else "White"
            messagebox.showinfo("Checkmate", f"Checkmate! {winner} wins.")
        elif self.chess_board.is_stalemate():
            messagebox.showinfo("Game Over", "Stalemate.")
        elif self.chess_board.is_insufficient_material():
            messagebox.showinfo("Game Over", "Draw by insufficient material.")
        elif self.chess_board.can_claim_threefold_repetition():
            messagebox.showinfo("Game Over", "Threefold repetition (claimable).")

    def _draw_board(self, highlight=None):
        # highlight: (row,col) for selected
        # Use neon colors: dark background with glowing squares
        light_color = "#1E1B4B"  # deep violet
        dark_color = "#05020A"   # almost black
        glow_color = "#9D4DFF"   # neon violet
        alt_glow = "#39FF14"     # neon green for selection

        # piece unicode mapping (white and black)
        piece_unicode = {
            chess.PAWN:   ("♙", "♟"),
            chess.ROOK:   ("♖", "♜"),
            chess.KNIGHT: ("♘", "♞"),
            chess.BISHOP: ("♗", "♝"),
            chess.QUEEN:  ("♕", "♛"),
            chess.KING:   ("♔", "♚"),
        }

        for r in range(8):
            for c in range(8):
                btn = self.chess_buttons.get((r, c))
                if not btn:
                    continue
                coord = self.square_to_coord[(r, c)]
                sq_index = chess.parse_square(coord)
                piece = self.chess_board.piece_at(sq_index)

                # square base color (checker pattern)
                if (r + c) % 2 == 0:
                    base = light_color
                else:
                    base = dark_color

                # if highlighted (selected)
                if highlight and (r, c) == highlight:
                    border_color = alt_glow
                    text_color = alt_glow
                else:
                    border_color = glow_color
                    text_color = "#EDEDED"

                # assemble display text (unicode)
                text = ""
                if piece:
                    uni = piece_unicode[piece.piece_type][0 if piece.color == chess.WHITE else 1]
                    text = uni

                # style: use fg_color as base and text color neon
                btn.configure(text=text, fg_color=base, text_color=text_color)
                # add a subtle border/glow by adjusting corner radius + highlight
                # CTk doesn't support outer glow easily; we simulate by changing fg_color and text_color

    # ---------------- end of class HyperKeyApp ----------------


