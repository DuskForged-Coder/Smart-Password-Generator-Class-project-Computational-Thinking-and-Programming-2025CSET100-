    def show_rps(self):
        for widget in self.main.winfo_children():
            widget.destroy()

        frame = ctk.CTkFrame(self.main)
        frame.pack(fill="both", expand=True, padx=20, pady=20)

        ctk.CTkLabel(frame, text="Rock - Paper - Scissors", font=("Orbitron", 24), text_color="#9D4DFF").pack(pady=10)

        icons = {"Rock": "✊", "Paper": "✋", "Scissors": "✌️"}

        def get_ai_choice():
 # Load history to predict user's next move
            history = load_rps_history()
            user_moves = history.get("user_moves", [])

 # If not enough history, make a random choice
            if len(user_moves) < 5: # Increased history threshold for better prediction
                return random.choice(["Rock", "Paper", "Scissors"])

 # Predict user's next move based on their last few moves (e.g., last 3)
            last_moves = user_moves[-3:] # Consider the last 3 moves
            most_frequent_last_move = max(set(last_moves), key=last_moves.count)

 # AI tries to counter the predicted user move
            if most_frequent_last_move == "Rock":
                return "Paper"
            elif most_frequent_last_move == "Paper":
                return "Scissors"
            else: # most_frequent_last_move == "Scissors"
                return "Rock" # AI plays Rock to beat Scissors

        # UI Elements
        result_label = ctk.CTkLabel(frame, text="Make Your Move", font=("Roboto", 20), text_color="#FFFFFF")
        result_label.pack(pady=10)

        choice_frame = ctk.CTkFrame(frame)
        choice_frame.pack(pady=10)

        user_label = ctk.CTkLabel(choice_frame, text="You: -", font=("Roboto", 18))
        user_label.grid(row=0, column=0, padx=40)

        ai_label = ctk.CTkLabel(choice_frame, text="Computer: -", font=("Roboto", 18))
        ai_label.grid(row=0, column=1, padx=40)

        def play(choice):
            history = load_rps_history()
            history.setdefault("user_moves", []).append(choice)
            save_rps_history(history)

            ai_choice = get_ai_choice()

            user_label.configure(text=f"You: {icons[choice]}")
            ai_label.configure(text=f"Computer: {icons[ai_choice]}")

            if choice == ai_choice:
                result_label.configure(text="Draw 😐", text_color="#CCCCCC")
            elif (
                (choice == "Rock" and ai_choice == "Scissors") or
                (choice == "Paper" and ai_choice == "Rock") or
                (choice == "Scissors" and ai_choice == "Paper")
            ):
                result_label.configure(text="You Win! 🎉", text_color="#39FF14")
            else:
                result_label.configure(text="You Lose ❌", text_color="#FF4444")

        # Buttons
        btn_frame = ctk.CTkFrame(frame, fg_color="transparent")
        btn_frame.pack(pady=10)

        ctk.CTkButton(btn_frame, text="✊ Rock", command=lambda: play("Rock"), width=130, fg_color="#9D4DFF").grid(row=0, column=0, padx=10)
        ctk.CTkButton(btn_frame, text="✋ Paper", command=lambda: play("Paper"), width=130, fg_color="#9D4DFF").grid(row=0, column=1, padx=10)
        ctk.CTkButton(btn_frame, text="✌️ Scissors", command=lambda: play("Scissors"), width=130, fg_color="#9D4DFF").grid(row=0, column=2, padx=10)

        # Trash Talk Section
        ctk.CTkLabel(frame, text="Trash Talk:", font=("Roboto", 14)).pack(pady=5)
        trash_entry = ctk.CTkEntry(frame, width=300)
        trash_entry.pack(pady=5)

        chat_box = ctk.CTkTextbox(frame, width=500, height=130)
        chat_box.pack(pady=10)

        def ai_trash():
            trash = [
                "You're going down!",
                "Is that all you've got?",
                "Too easy!",
                "My circuits are laughing!",
                "Pathetic move!"
            ]
            chat_box.insert("end", f"AI: {random.choice(trash)}\n")

        def send_msg():
            msg = trash_entry.get().strip()
            if msg:
                chat_box.insert("end", f"You: {msg}\n")
                trash_entry.delete(0, tk.END)
                self.after(500, ai_trash)

        ctk.CTkButton(frame, text="SEND", fg_color="#FFAA00", text_color="#000", command=send_msg).pack(pady=5)

